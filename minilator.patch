+        String authority = uri.getAuthority();
+        if (authority != null) {
+            if (authority.equals("com.android.externalstorage.documents")) {
+                String[] parts = uri.getLastPathSegment().split(":");
+                if (parts.length > 1) {
+                    if (parts[0].equalsIgnoreCase("primary")) {
+                        path = Environment.getExternalStorageDirectory() + "/" + parts[1];
+                    }
+                    else {
+                        path = "/storage/" + parts[0] + "/" + parts[1];
+                    }
+                }
+            }
+            else if (authority.equals("com.android.providers.downloads.documents")) {
+                String id = uri.getLastPathSegment();
+                if (id != null) {
+                    if (id.startsWith("raw:")) {
+                        path = id.replaceFirst("raw:", "");
+                    }
+                    else {
+                        String[] parts = id.split(":");
+                        if (parts.length > 1) {
+                            path = Environment.getExternalStoragePublicDirectory(Environment.DIRECTORY_DOWNLOADS) + "/" + parts[1];
+                        }
+                    }
+                }
+            }
+        }
+        if (path == null && uri.getPath() != null && uri.getPath().startsWith("/storage/")) {
+            path = uri.getPath();
         }
         return path;
     }
diff --git a/app/src/main/java/com/winlator/core/GameImporter.java b/app/src/main/java/com/winlator/core/GameImporter.java
new file mode 100644
index 0000000..2a34aad
--- /dev/null
+++ b/app/src/main/java/com/winlator/core/GameImporter.java
@@ -0,0 +1,117 @@
+package com.winlator.core;
+
+import android.content.Context;
+import android.graphics.Bitmap;
+import android.net.Uri;
+
+import com.winlator.box64.Box64Preset;
+import com.winlator.container.Container;
+import com.winlator.container.ContainerManager;
+import com.winlator.win32.PEParser;
+
+import java.io.File;
+import java.io.FileOutputStream;
+
+public class GameImporter {
+    public static void importGame(Context context, Uri fileUri, Callback<Boolean> callback) {
+        String filePath = FileUtils.getFilePathFromUri(fileUri);
+        if (filePath == null || !filePath.toLowerCase().endsWith(".exe")) {
+            if (callback != null) callback.call(false);
+            return;
+        }
+
+        File peFile = new File(filePath);
+        if (!peFile.exists()) {
+            if (callback != null) callback.call(false);
+            return;
+        }
+
+        ContainerManager manager = new ContainerManager(context);
+        if (manager.getContainers().isEmpty()) {
+            manager.createDefaultContainerAsync((container) -> {
+                if (container != null) {
+                    boolean success = createShortcutForExe(container, peFile);
+                    if (callback != null) callback.call(success);
+                }
+                else {
+                    if (callback != null) callback.call(false);
+                }
+            });
+        }
+        else {
+            Container container = manager.getContainers().get(0);
+            boolean success = createShortcutForExe(container, peFile);
+            if (callback != null) callback.call(success);
+        }
+    }
+
+    public static boolean createShortcutForExe(Container container, File peFile) {
+        try {
+            String fullPath = peFile.getAbsolutePath();
+            String dosPath;
+            String downloadPath = AppUtils.DIRECTORY_DOWNLOADS;
+            String storagePath = AppUtils.INTERNAL_STORAGE;
+
+            if (fullPath.startsWith(downloadPath)) {
+                dosPath = "D:" + fullPath.substring(downloadPath.length()).replace("/", "\\");
+            }
+            else if (fullPath.startsWith(storagePath)) {
+                dosPath = "E:" + fullPath.substring(storagePath.length()).replace("/", "\\");
+            }
+            else {
+                dosPath = "E:" + fullPath.replace("/", "\\");
+            }
+
+            // Extract game name
+            String gameName = peFile.getName();
+            if (gameName.toLowerCase().endsWith(".exe")) {
+                gameName = gameName.substring(0, gameName.length() - 4);
+            }
+            try {
+                PEParser.FileVersionInfo info = PEParser.getFileVersionInfo(peFile);
+                if (info != null && info.ProductName != null && !info.ProductName.trim().isEmpty()) {
+                    gameName = info.ProductName.trim();
+                }
+            }
+            catch (Exception ignored) {}
+
+            String safeFileName = gameName.replaceAll("[^a-zA-Z0-9._\\- ]", "_");
+            String iconName = safeFileName.toLowerCase().replace(" ", "_");
+
+            // Extract icon
+            try {
+                Bitmap icon = PEParser.extractIcon(peFile);
+                if (icon != null) {
+                    File iconDir = container.getIconsDir(48);
+                    iconDir.mkdirs();
+                    File iconFile = new File(iconDir, iconName + ".png");
+                    try (FileOutputStream out = new FileOutputStream(iconFile)) {
+                        icon.compress(Bitmap.CompressFormat.PNG, 100, out);
+                    }
+                }
+            }
+            catch (Exception ignored) {}
+
+            // Write .desktop entry
+            File desktopDir = new File(container.getUserDir(), "Desktop");
+            desktopDir.mkdirs();
+            File desktopFile = new File(desktopDir, safeFileName + ".desktop");
+
+            StringBuilder sb = new StringBuilder();
+            sb.append("[Desktop Entry]\n");
+            sb.append("Name=").append(gameName).append("\n");
+            sb.append("Exec=env WINEPREFIX=\"").append(container.getRootDir().getPath()).append("/.wine\" wine \"").append(dosPath).append("\"\n");
+            sb.append("Type=Application\n");
+            sb.append("StartupNotify=true\n");
+            sb.append("Icon=").append(iconName).append("\n\n");
+            sb.append("[Extra Data]\n");
+            sb.append("box64Preset=").append(Box64Preset.TURBO).append("\n");
+            sb.append("screenSize=").append(Container.DEFAULT_SCREEN_SIZE).append("\n");
+
+            return FileUtils.writeString(desktopFile, sb.toString());
+        }
+        catch (Exception e) {
+            return false;
+        }
+    }
+}
