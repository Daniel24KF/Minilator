diff --git a/.github/workflows/build-minilator.yml b/.github/workflows/build-minilator.yml
new file mode 100644
index 0000000..1a1d762
--- /dev/null
+++ b/.github/workflows/build-minilator.yml
@@ -0,0 +1,62 @@
+name: Build Minilator APK
+
+on:
+  push:
+    branches: [ main, master ]
+    tags:
+      - 'v*'
+  pull_request:
+    branches: [ main, master ]
+  workflow_dispatch:
+
+jobs:
+  build:
+    name: Build Minilator ARM64 APK
+    runs-on: ubuntu-latest
+
+    steps:
+      - name: Checkout Code
+        uses: actions/checkout@v4
+        with:
+          submodules: recursive
+
+      - name: Set up JDK 17
+        uses: actions/setup-java@v4
+        with:
+          java-version: '17'
+          distribution: 'temurin'
+          cache: 'gradle'
+
+      - name: Set up Android NDK
+        uses: nttld/setup-ndk@v1
+        with:
+          ndk-version: r24
+          link-to-sdk: true
+
+      - name: Grant Execute Permission for Gradlew
+        run: chmod +x ./gradlew
+
+      - name: Build Minilator APK (Debug)
+        run: ./gradlew assembleDebug --stacktrace
+
+      - name: Upload Minilator APK Artifact
+        uses: actions/upload-artifact@v4
+        with:
+          name: Minilator-v1.0-arm64-debug
+          path: app/build/outputs/apk/debug/*.apk
+
+      - name: Create GitHub Release (On Tag)
+        if: startsWith(github.ref, 'refs/tags/v')
+        uses: softprops/action-gh-release@v2
+        with:
+          files: app/build/outputs/apk/debug/*.apk
+          name: Minilator Release ${{ github.ref_name }}
+          body: |
+            ### Minilator - Minimalist High-Performance Winlator Fork
+            - **Minimalist Console UI:** Game Library first, zero Windows desktop clutter.
+            - **1-Click Game Importer:** Tap `+` to add any `.exe` from storage.
+            - **Turbo Box64 Dynarec:** Mega-block JIT translation with fast hardware NaN/rounding.
+            - **Asynchronous DXVK GPL:** Background Vulkan shader compilation to eliminate stutter.
+            - **Intelligent CPU Affinity:** Excludes slow efficiency cores to stabilize 60 FPS.
+        env:
+          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
